<Window x:Class="EmployeeScheduleManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie" Height="200" Width="350" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nazwa użytkownika:"/>
        <TextBox x:Name="UsernameTextBox" Grid.Row="1" Margin="0,5"/>

        <TextBlock Text="Hasło:" Grid.Row="2" Margin="0,10,0,0"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Margin="0,5"/>

        <Button Content="Zaloguj" Width="100" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0" Grid.Row="4"
                Click="LoginButton_Click"/>
    </Grid>
</Window>
