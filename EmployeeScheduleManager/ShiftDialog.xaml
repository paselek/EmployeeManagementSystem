<Window x:Class="EmployeeScheduleManager.ShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj Zmianę" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Dzień:" FontWeight="Bold"/>
        <Label Grid.Row="0" Grid.Column="1"  x:Name="DayLabel" />

        <Label Content="Godziny otwarcia:" FontWeight="Bold" Grid.Row="1" Grid.Column="0"/>
        <Label x:Name="OpeningHoursLabel" Grid.Row="1" Grid.Column="1"/>

        <!-- Pracownik -->
        <Label Grid.Row="2" Grid.Column="0" Content="Pracownik:"  FontWeight="Bold" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EmployeeComboBox" DisplayMemberPath="FullName" Margin="5" SelectionChanged="EmployeeComboBox_SelectionChanged" />
        
        <!-- niedostępność-->
        <Label Grid.Row="3" Grid.Column="0" Content="Niedostępny:" FontWeight="Bold" VerticalAlignment="Center"/>
        <Label Grid.Row="3" Grid.Column="1" x:Name="UnavaTextBox" Margin="5"/>
        
        <!-- Godzina rozpoczęcia -->
        <Label Grid.Row="4" Grid.Column="0" Content="Początek:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="StartTimeTextBox" Margin="5" PreviewTextInput="StartTimeTextBox_PreviewTextInput"
         TextChanged="StartTimeTextBox_TextChanged" />

        <!-- Godzina zakończenia -->
        <Label Grid.Row="5" Grid.Column="0" Content="Koniec:" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="EndTimeTextBox" Margin="5" PreviewTextInput="EndTimeTextBox_PreviewTextInput"
         TextChanged="EndTimeTextBox_TextChanged" />

        <!-- Pozycja -->
        <Label Grid.Row="6" Grid.Column="0" Content="Stanowisko:"  FontWeight="Bold" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="PositionComboBox" Margin="5" />

        <!-- Przyciski -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Zapisz" Width="75" Margin="5" Click="SaveButton_Click"/>
            <Button Content="Anuluj" Width="75" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>