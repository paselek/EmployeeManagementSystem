<Window x:Class="EmployeeScheduleManager.ShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj Zmianę" Height="250" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Godzina rozpoczęcia -->
        <Label Grid.Row="0" Grid.Column="0" Content="Początek:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="StartTimeTextBox" Margin="5"/>

        <!-- Godzina zakończenia -->
        <Label Grid.Row="1" Grid.Column="0" Content="Koniec:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="EndTimeTextBox" Margin="5"/>

        <!-- Pracownik -->
        <Label Grid.Row="2" Grid.Column="0" Content="Pracownik:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="EmployeeComboBox" DisplayMemberPath="FullName" Margin="5" />

        <!-- Przyciski -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Zapisz" Width="75" Margin="5" Click="SaveButton_Click"/>
            <Button Content="Anuluj" Width="75" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>